From 7e23f7c57021f8d5220172dd5dcbfae44b113711 Mon Sep 17 00:00:00 2001
From: Brhett <36874370+jingledingle521@users.noreply.github.com>
Date: Sun, 25 Oct 2026 18:42:53 -0500
Subject: [PATCH 48/48] Finder: keep Drive stalls short; log hangs on FUSE
 mounts

Folder listings on Google Drive now stay cached (the change feed keeps
them current); after the old 5-minute expiry, the next stat from the GUI
thread waited on the network. rclone also gives up on a dead connection
in seconds instead of minutes, and the kernel caches attributes for 10 s.

The hang watch reads the GUI thread's syscall, wait channel and path from
/proc before running eu-stack, skips eu-stack while the thread waits on
a FUSE mount (it can't be stopped), kills eu-stack after 5 s, and sends
SIGCONT so its pending SIGSTOP can't leave Finder stopped.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012jNuTPwrNPo8VLS8Y4BgCY
---
 src/finder/findercloud.cpp     | 13 ++++--
 src/finder/finderhangwatch.cpp | 82 ++++++++++++++++++++++++++++++++--
 2 files changed, 89 insertions(+), 6 deletions(-)

diff --git a/src/finder/findercloud.cpp b/src/finder/findercloud.cpp
index 960b2f84c..9d585a931 100644
--- a/src/finder/findercloud.cpp
+++ b/src/finder/findercloud.cpp
@@ -352,8 +352,14 @@ bool FinderCloud::writeUnit()
     const QString socket = QFileInfo(socketPath()).fileName();
     const QString cache = cachePath().section(QLatin1Char('/'), -2); // finder/<drive>
     // Google exports Docs, Sheets and Slides as Office files; iCloud has no
-    // such documents, and no change feed to poll.
-    const QString extra = m_provider == GoogleDrive ? QStringLiteral("    --poll-interval 1m \\\n    --drive-export-formats docx,xlsx,pptx,svg \\\n") : QString();
+    // such documents, and no change feed to poll. With the change feed, folder
+    // listings can stay cached: once they expire, the next stat of a folder
+    // (Finder checks whether it may paste there) waits on the network.
+    const QString extra = m_provider == GoogleDrive
+        ? QStringLiteral("    --dir-cache-time 1000h \\\n    --poll-interval 1m \\\n    --drive-export-formats docx,xlsx,pptx,svg \\\n")
+        : QStringLiteral("    --dir-cache-time 5m \\\n");
+    // Finder's windows wait on the mount, so a dropped connection should fail
+    // in seconds (--timeout, --contimeout), not rclone's minutes per try.
     // The rc socket sits in the user's runtime dir (mode 0700), so only this
     // user reaches it; --rc-no-auth lets Finder ask the provider for the quota.
     const QString text = QStringLiteral(
@@ -376,7 +382,8 @@ bool FinderCloud::writeUnit()
                              "    --volname \"%6\" \\\n"
                              "    --vfs-cache-mode full \\\n"
                              "    --vfs-cache-max-size 10G \\\n"
-                             "    --dir-cache-time 5m \\\n"
+                             "    --contimeout 5s --timeout 15s --low-level-retries 3 \\\n"
+                             "    --attr-timeout 10s \\\n"
                              "%4"
                              "    --rc --rc-addr unix://%t/%7 --rc-no-auth\n"
                              "ExecStop=/usr/bin/fusermount3 -uz \"%h/%6\"\n"
diff --git a/src/finder/finderhangwatch.cpp b/src/finder/finderhangwatch.cpp
index 7a9370562..7d6d5d859 100644
--- a/src/finder/finderhangwatch.cpp
+++ b/src/finder/finderhangwatch.cpp
@@ -17,11 +17,15 @@
 
 #include <atomic>
 #include <chrono>
+#include <csignal>
 #include <cstdlib>
 #include <mutex>
 #include <thread>
 
 #include <sys/prctl.h>
+#include <sys/syscall.h>
+#include <sys/uio.h>
+#include <sys/wait.h>
 #include <unistd.h>
 
 namespace
@@ -60,6 +64,67 @@ QByteArray stamp()
     return QDateTime::currentDateTime().toString(QStringLiteral("yyyy-MM-dd HH:mm:ss.zzz")).toUtf8();
 }
 
+QByteArray readProc(const QByteArray &name)
+{
+    QFile file(QStringLiteral("/proc/self/task/%1/").arg(getpid()) + QString::fromLatin1(name));
+    return file.open(QIODevice::ReadOnly) ? file.readAll().trimmed() : QByteArray();
+}
+
+// What the GUI thread is blocked in, from /proc. This works even when
+// eu-stack can't attach: a thread waiting on a FUSE mount (Google Drive)
+// can't be stopped until the mount answers.
+QByteArray guiSyscall()
+{
+    const QList<QByteArray> fields = readProc("syscall").split(' ');
+    QByteArray out = "    blocked in " + readProc("wchan");
+    if (fields.size() < 4 || fields.first() == "running") {
+        return out + '\n';
+    }
+    const long nr = fields[0].toLong();
+    out += ", syscall " + fields[0];
+    // Syscalls that take a path: which argument holds it (x86-64).
+    int arg = 0;
+    switch (nr) {
+#ifdef __x86_64__
+    case SYS_open:
+    case SYS_stat:
+    case SYS_lstat:
+    case SYS_access:
+    case SYS_readlink:
+    case SYS_getxattr:
+    case SYS_lgetxattr:
+    case SYS_listxattr:
+    case SYS_statfs:
+        arg = 1;
+        break;
+#endif
+    case SYS_openat:
+    case SYS_newfstatat:
+    case SYS_statx:
+    case SYS_faccessat:
+    case SYS_faccessat2:
+    case SYS_readlinkat:
+        arg = 2;
+        break;
+    default:
+        break;
+    }
+    if (arg) {
+        // The path is in our own memory; process_vm_readv fails cleanly
+        // instead of crashing if the pointer is bad.
+        char path[4096] = {};
+        iovec local{path, sizeof(path) - 1};
+        iovec remote{reinterpret_cast<void *>(fields[arg].toULongLong(nullptr, 16)), sizeof(path) - 1};
+        if (process_vm_readv(getpid(), &local, 1, &remote, 1, 0) > 0) {
+            out += " on \"" + QByteArray(path) + '"';
+        }
+    } else if (nr == SYS_read || nr == SYS_write || nr == SYS_fstat || nr == SYS_ioctl || nr == SYS_getdents64) {
+        const QByteArray fd = QByteArray::number(fields[1].toLongLong(nullptr, 16));
+        out += " on fd " + fd + " -> " + QFile::encodeName(QFile::symLinkTarget(QStringLiteral("/proc/self/fd/") + QString::fromLatin1(fd)));
+    }
+    return out + '\n';
+}
+
 // The GUI thread's stack (its thread id is the process id), from eu-stack.
 // Every thread is stopped while eu-stack unwinds, for a fraction of a second.
 QByteArray guiStack()
@@ -70,12 +135,19 @@ QByteArray guiStack()
     // downloading symbols would freeze Finder for minutes.
     const QString runtime = qEnvironmentVariable("XDG_RUNTIME_DIR", QDir::tempPath());
     const QByteArray outPath = QFile::encodeName(runtime + QStringLiteral("/finder-hang-%1.txt").arg(pid));
-    const QByteArray command = "DEBUGINFOD_URLS= eu-stack -m -p " + QByteArray::number(pid) + " > '" + outPath + "' 2>&1";
+    // And a time limit: eu-stack waits forever for a thread it can't stop.
+    const QByteArray command = "DEBUGINFOD_URLS= timeout -s KILL 5 eu-stack -m -p " + QByteArray::number(pid) + " > '" + outPath + "' 2>&1";
     const int status = std::system(command.constData());
     QFile file(QFile::decodeName(outPath));
     const QByteArray out = file.open(QIODevice::ReadOnly) ? file.readAll() : QByteArray();
     file.remove();
     if (out.isEmpty()) {
+        if (WIFEXITED(status) && WEXITSTATUS(status) == 128 + SIGKILL) {
+            // eu-stack died with its SIGSTOP still pending; once the thread
+            // came back, Finder would stop for good. SIGCONT discards it.
+            kill(pid, SIGCONT);
+            return "    (eu-stack couldn't stop the thread within 5 s)\n";
+        }
         return status == 0 ? "    (eu-stack printed nothing)\n" : "    (eu-stack failed; is elfutils installed? sudo dnf install elfutils)\n";
     }
 
@@ -139,8 +211,12 @@ void watch()
                 append(stamp() + "  HANG: the window stopped responding  [" + stallContext + "]\n");
             }
             ++samples;
-            const QByteArray stack = guiStack();
-            append("  after " + QByteArray::number(now - hangStart) + " ms:\n" + stack);
+            // Before eu-stack, which can take seconds and stops the thread.
+            append("  after " + QByteArray::number(now - hangStart) + " ms:\n" + guiSyscall());
+            // A thread waiting on a FUSE mount can't be stopped; don't try.
+            if (readProc("wchan") != "request_wait_answer") {
+                append(guiStack());
+            }
             // Again at 2, 5, 10, 20… seconds: what changes is what it's waiting on.
             static const int gaps[] = {1500, 3000, 5000, 10000, 10000, 30000, 60000};
             nextSample = now + gaps[qMin(samples - 1, 6)];
