diff --git a/discover/qml/MacAppRow.qml b/discover/qml/MacAppRow.qml
new file mode 100644
index 000000000..ea59c3d2b
--- /dev/null
+++ b/discover/qml/MacAppRow.qml
@@ -0,0 +1,99 @@
+// SPDX-FileCopyrightText: 2026 Brhett
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+import org.kde.discover as Discover
+import org.kde.kirigami as Kirigami
+
+// App Store: an app in a list, as macOS's: its icon, name and one-line
+// description, the Get button at the right, and a hairline under the text
+// (`separator`). Clicking anywhere else opens the app's page.
+MouseArea {
+    id: row
+
+    required property Discover.AbstractResource application
+    property bool separator: true
+    // Under the name: the description, or (Your Apps) the size.
+    property string detail: application.comment
+
+    implicitHeight: Kirigami.Units.gridUnit * 4
+    hoverEnabled: true
+    activeFocusOnTab: true
+    Accessible.role: Accessible.ListItem
+    Accessible.name: application.name
+    Accessible.onPressAction: open()
+
+    function open() {
+        Navigation.openApplication(application);
+    }
+
+    onClicked: open()
+    Keys.onReturnPressed: open()
+    Keys.onEnterPressed: open()
+
+    RowLayout {
+        id: content
+        anchors.fill: parent
+        spacing: Kirigami.Units.largeSpacing
+
+        Kirigami.Icon {
+            id: icon
+            Layout.preferredWidth: Kirigami.Units.gridUnit * 3.2
+            Layout.preferredHeight: Layout.preferredWidth
+            source: row.application.icon
+            animated: false
+        }
+
+        ColumnLayout {
+            Layout.fillWidth: true
+            spacing: 1
+
+            QQC2.Label {
+                Layout.fillWidth: true
+                text: row.application.name
+                font.weight: Font.DemiBold
+                elide: Text.ElideRight
+                maximumLineCount: 1
+                textFormat: Text.PlainText
+            }
+            QQC2.Label {
+                Layout.fillWidth: true
+                text: row.detail
+                font: Kirigami.Theme.smallFont
+                opacity: 0.6
+                elide: Text.ElideRight
+                wrapMode: Text.Wrap
+                maximumLineCount: 2
+                textFormat: Text.PlainText
+            }
+        }
+
+        MacGetButton {
+            Layout.alignment: Qt.AlignVCenter
+            application: row.application
+        }
+    }
+
+    // Keyboard focus: a soft ring around the row.
+    Rectangle {
+        anchors.fill: parent
+        anchors.margins: -Kirigami.Units.smallSpacing
+        visible: row.activeFocus
+        radius: 8
+        color: "transparent"
+        border.width: 2
+        border.color: Kirigami.Theme.focusColor
+    }
+
+    Rectangle {
+        visible: row.separator
+        anchors.bottom: parent.bottom
+        anchors.right: parent.right
+        x: icon.width + content.spacing
+        width: parent.width - x
+        height: 1
+        color: Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b, 0.1)
+    }
+}
diff --git a/discover/qml/MacCategoriesPage.qml b/discover/qml/MacCategoriesPage.qml
new file mode 100644
index 000000000..8139598fc
--- /dev/null
+++ b/discover/qml/MacCategoriesPage.qml
@@ -0,0 +1,99 @@
+// SPDX-FileCopyrightText: 2026 Brhett
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+import org.kde.discover as Discover
+import org.kde.kirigami as Kirigami
+
+// App Store: macOS's Categories page. A large title, then a tile for each
+// category: its glyph in white on a colour of its own, and its name.
+// Clicking one lists its apps.
+DiscoverPage {
+    id: page
+
+    title: i18nc("@title", "Categories")
+    readonly property bool macOwnTitle: true
+
+    // macOS's category colours, in turn.
+    readonly property var tints: ["#0a84ff", "#ff9f0a", "#30d158", "#bf5af2", "#ff375f", "#64d2ff", "#ffd60a", "#5e5ce6", "#ff453a", "#63e6e2", "#ac8e68"]
+
+    ColumnLayout {
+        spacing: Kirigami.Units.gridUnit * 1.5
+
+        Kirigami.Heading {
+            Layout.fillWidth: true
+            level: 1
+            font.weight: Font.Bold
+            font.pointSize: Kirigami.Theme.defaultFont.pointSize * 2.1
+            text: page.title
+        }
+
+        GridLayout {
+            id: grid
+            Layout.fillWidth: true
+            columns: Math.max(1, Math.floor((width + columnSpacing) / (Kirigami.Units.gridUnit * 13 + columnSpacing)))
+            columnSpacing: Kirigami.Units.gridUnit
+            rowSpacing: Kirigami.Units.gridUnit
+
+            Repeater {
+                model: Discover.CategoryModel.rootCategories
+                delegate: MouseArea {
+                    id: tile
+                    required property var modelData
+                    required property int index
+                    readonly property Discover.Category category: Discover.CategoryModel.get(modelData)
+                    readonly property color tint: page.tints[index % page.tints.length]
+
+                    visible: category?.visible ?? false
+                    Layout.fillWidth: true
+                    Layout.preferredWidth: 1
+                    implicitHeight: Kirigami.Units.gridUnit * 4
+                    hoverEnabled: true
+                    cursorShape: Qt.PointingHandCursor
+                    Accessible.role: Accessible.Button
+                    Accessible.name: category?.name ?? ""
+                    onClicked: Navigation.openCategory(modelData)
+
+                    Rectangle {
+                        anchors.fill: parent
+                        radius: 12
+                        color: Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b, tile.containsMouse ? 0.1 : 0.06)
+                    }
+                    RowLayout {
+                        anchors.fill: parent
+                        anchors.margins: Kirigami.Units.largeSpacing
+                        spacing: Kirigami.Units.largeSpacing
+
+                        Rectangle {
+                            Layout.preferredWidth: Kirigami.Units.gridUnit * 2.4
+                            Layout.preferredHeight: Layout.preferredWidth
+                            radius: width * 0.23
+                            color: tile.tint
+                            Kirigami.Icon {
+                                anchors.centerIn: parent
+                                width: parent.width * 0.6
+                                height: width
+                                source: (tile.category?.icon ?? "") + "-symbolic"
+                                fallback: tile.category?.icon ?? ""
+                                isMask: true
+                                color: "white"
+                            }
+                        }
+                        QQC2.Label {
+                            Layout.fillWidth: true
+                            text: tile.category?.name ?? ""
+                            font.weight: Font.DemiBold
+                            elide: Text.ElideRight
+                            wrapMode: Text.Wrap
+                            maximumLineCount: 2
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/discover/qml/MacFeatureCard.qml b/discover/qml/MacFeatureCard.qml
new file mode 100644
index 000000000..3929cdd1b
--- /dev/null
+++ b/discover/qml/MacFeatureCard.qml
@@ -0,0 +1,129 @@
+// SPDX-FileCopyrightText: 2026 Brhett
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+import org.kde.discover as Discover
+import org.kde.kirigami as Kirigami
+
+// App Store: one of the large editorial cards at the top of macOS's
+// Discover page: the app's first screenshot (or its icon's colour) behind a
+// darkening at the bottom, a small caption, the app's name and description
+// in white, its icon and the Get button. Clicking opens the app's page.
+MouseArea {
+    id: card
+
+    required property Discover.AbstractResource application
+    property string caption: i18nc("@label on a featured app", "Editors' Choice")
+    property url shot
+
+    hoverEnabled: true
+    cursorShape: Qt.PointingHandCursor
+    Accessible.role: Accessible.Button
+    Accessible.name: application.name
+    onClicked: Navigation.openApplication(application)
+
+    Discover.ScreenshotsModel {
+        id: shots
+        application: card.application
+    }
+    Instantiator {
+        model: shots
+        delegate: QtObject {
+            required property int index
+            required property url large_image_url
+            Component.onCompleted: if (index === 0) card.shot = large_image_url
+        }
+    }
+    Kirigami.ImageColors {
+        id: colors
+        source: card.application.icon
+    }
+
+    // The picture, rounded; the icon's colour until (or without) one.
+    Kirigami.ShadowedRectangle {
+        anchors.fill: parent
+        radius: 12
+        color: Qt.darker(colors.dominant, 1.6)
+        shadow.size: card.containsMouse ? 18 : 10
+        shadow.yOffset: 3
+        shadow.color: Qt.rgba(0, 0, 0, 0.35)
+    }
+    Kirigami.ShadowedTexture {
+        anchors.fill: parent
+        radius: 12
+        visible: picture.status === Image.Ready
+        source: Image {
+            id: picture
+            source: card.shot
+            fillMode: Image.PreserveAspectCrop
+            asynchronous: true
+            sourceSize.width: card.width * 1.5
+        }
+    }
+    // Darker towards the bottom, under the text.
+    Rectangle {
+        anchors.fill: parent
+        radius: 12
+        gradient: Gradient {
+            GradientStop { position: 0.3; color: "transparent" }
+            GradientStop { position: 0.62; color: Qt.rgba(0, 0, 0, 0.6) }
+            GradientStop { position: 1.0; color: Qt.rgba(0, 0, 0, 0.88) }
+        }
+    }
+
+    ColumnLayout {
+        anchors.fill: parent
+        anchors.margins: Kirigami.Units.gridUnit
+        spacing: 2
+
+        Item {
+            Layout.fillHeight: true
+        }
+        QQC2.Label {
+            text: card.caption
+            font.weight: Font.Bold
+            font.capitalization: Font.AllUppercase
+            font.pointSize: Kirigami.Theme.smallFont.pointSize
+            color: Qt.rgba(1, 1, 1, 0.7)
+        }
+        RowLayout {
+            Layout.fillWidth: true
+            spacing: Kirigami.Units.largeSpacing
+
+            Kirigami.Icon {
+                Layout.preferredWidth: Kirigami.Units.gridUnit * 2.8
+                Layout.preferredHeight: Layout.preferredWidth
+                source: card.application.icon
+                animated: false
+            }
+            ColumnLayout {
+                Layout.fillWidth: true
+                spacing: 0
+                QQC2.Label {
+                    Layout.fillWidth: true
+                    text: card.application.name
+                    color: "white"
+                    font.weight: Font.Bold
+                    font.pointSize: Kirigami.Theme.defaultFont.pointSize * 1.35
+                    elide: Text.ElideRight
+                    textFormat: Text.PlainText
+                }
+                QQC2.Label {
+                    Layout.fillWidth: true
+                    text: card.application.comment
+                    color: Qt.rgba(1, 1, 1, 0.8)
+                    elide: Text.ElideRight
+                    textFormat: Text.PlainText
+                }
+            }
+            MacGetButton {
+                application: card.application
+                onDark: true
+            }
+        }
+    }
+}
diff --git a/discover/qml/MacGetButton.qml b/discover/qml/MacGetButton.qml
new file mode 100644
index 000000000..7360752c8
--- /dev/null
+++ b/discover/qml/MacGetButton.qml
@@ -0,0 +1,152 @@
+// SPDX-FileCopyrightText: 2026 Brhett
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Shapes
+import org.kde.discover as Discover
+import org.kde.kirigami as Kirigami
+
+// App Store: macOS's Get button. A capsule reading Get (not installed),
+// Open (installed, can be launched) or Installed; while installing, a ring
+// filling with progress around a stop square (click to cancel). In lists it
+// is gray with the label in the accent colour; `prominent` (an app's page)
+// fills it with the accent and the label turns white.
+Item {
+    id: root
+
+    required property Discover.AbstractResource application
+    property bool prominent: false
+    // Over a picture: a light, translucent capsule with a white label.
+    property bool onDark: false
+
+    readonly property alias listener: listener
+    readonly property bool busy: listener.isActive
+    readonly property bool broken: application.state === Discover.AbstractResource.Broken
+    readonly property bool canOpen: application.isInstalled && application.canExecute
+
+    readonly property string label: {
+        if (broken) {
+            return i18nc("@action:button the app's state is still being fetched", "…");
+        }
+        if (!application.isInstalled) {
+            return i18nc("@action:button install an app", "Get");
+        }
+        return canOpen ? i18nc("@action:button launch an app", "Open")
+                       : i18nc("@info the app is installed", "Installed");
+    }
+
+    function click() {
+        if (busy) {
+            if (listener.isCancellable) {
+                listener.cancel();
+            }
+        } else if (!application.isInstalled) {
+            Discover.ResourcesModel.installApplication(application);
+        } else if (canOpen) {
+            application.invokeApplication();
+        }
+    }
+
+    implicitWidth: busy ? ring.width : Math.max(Kirigami.Units.gridUnit * 3.6, text.implicitWidth + Kirigami.Units.gridUnit * 1.4)
+    implicitHeight: Math.round(text.implicitHeight + Kirigami.Units.smallSpacing * 2.2)
+
+    Accessible.role: Accessible.Button
+    Accessible.name: busy ? i18nc("@action:button", "Stop") : label
+    Accessible.onPressAction: click()
+
+    Discover.TransactionListener {
+        id: listener
+        resource: root.application
+    }
+
+    // The capsule.
+    Rectangle {
+        anchors.fill: parent
+        visible: !root.busy
+        radius: height / 2
+        color: {
+            if (root.onDark) {
+                return Qt.rgba(1, 1, 1, mouse.pressed ? 0.4 : mouse.containsMouse ? 0.32 : 0.24);
+            }
+            const t = Kirigami.Theme.textColor;
+            if (root.prominent && !root.application.isInstalled) {
+                return mouse.pressed ? Qt.darker(Kirigami.Theme.focusColor, 1.15) : Kirigami.Theme.focusColor;
+            }
+            return Qt.rgba(t.r, t.g, t.b, mouse.pressed ? 0.22 : mouse.containsMouse ? 0.17 : 0.12);
+        }
+        opacity: root.broken ? 0.5 : 1
+
+        QQC2.Label {
+            id: text
+            anchors.centerIn: parent
+            text: root.label
+            font.weight: Font.Bold
+            font.capitalization: Font.AllUppercase
+            color: root.onDark || (root.prominent && !root.application.isInstalled) ? "white"
+                 : root.application.isInstalled && !root.canOpen ? Kirigami.Theme.disabledTextColor
+                 : Kirigami.Theme.focusColor
+        }
+    }
+
+    // Installing: a ring filling up around a stop square.
+    Item {
+        id: ring
+        anchors.centerIn: parent
+        visible: root.busy
+        width: root.height
+        height: width
+
+        Shape {
+            anchors.fill: parent
+            preferredRendererType: Shape.CurveRenderer
+            ShapePath {
+                strokeColor: Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b, 0.18)
+                strokeWidth: 2.5
+                fillColor: "transparent"
+                PathAngleArc {
+                    centerX: ring.width / 2
+                    centerY: ring.height / 2
+                    radiusX: ring.width / 2 - 2
+                    radiusY: radiusX
+                    startAngle: 0
+                    sweepAngle: 360
+                }
+            }
+            ShapePath {
+                strokeColor: Kirigami.Theme.focusColor
+                strokeWidth: 2.5
+                fillColor: "transparent"
+                capStyle: ShapePath.RoundCap
+                PathAngleArc {
+                    centerX: ring.width / 2
+                    centerY: ring.height / 2
+                    radiusX: ring.width / 2 - 2
+                    radiusY: radiusX
+                    startAngle: -90
+                    sweepAngle: 360 * Math.max(0.02, listener.progress / 100)
+                }
+            }
+        }
+        Rectangle {
+            anchors.centerIn: parent
+            visible: listener.isCancellable
+            width: ring.width * 0.3
+            height: width
+            radius: 1.5
+            color: Kirigami.Theme.focusColor
+        }
+    }
+
+    MouseArea {
+        id: mouse
+        anchors.fill: parent
+        hoverEnabled: true
+        enabled: !root.broken && (root.busy || !root.application.isInstalled || root.canOpen)
+        onClicked: root.click()
+    }
+
+    QQC2.ToolTip.text: listener.statusText
+    QQC2.ToolTip.visible: root.busy && mouse.containsMouse
+    QQC2.ToolTip.delay: Kirigami.Units.toolTipDelay
+}
diff --git a/discover/qml/MacShelf.qml b/discover/qml/MacShelf.qml
new file mode 100644
index 000000000..839aaa598
--- /dev/null
+++ b/discover/qml/MacShelf.qml
@@ -0,0 +1,83 @@
+// SPDX-FileCopyrightText: 2026 Brhett
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+import org.kde.kirigami as Kirigami
+
+// App Store: a shelf of apps, as on macOS's Discover page: a bold title
+// with See All at the right, then apps in columns (as many as fit, rows of
+// `rows`), each a MacAppRow. `model` gives apps in the `application` role.
+ColumnLayout {
+    id: shelf
+
+    property string title
+    property alias model: repeater.model
+    property int rows: 3
+    // Called by See All; none hides it.
+    property var seeAll: null
+
+    readonly property int columns: Math.max(1, Math.min(3, Math.floor((width + grid.columnSpacing) / (Kirigami.Units.gridUnit * 14 + grid.columnSpacing))))
+    readonly property alias count: repeater.count
+    readonly property int shown: Math.min(repeater.count, columns * rows)
+
+    visible: repeater.count > 0
+    spacing: Kirigami.Units.smallSpacing
+
+    // A hairline above, as between macOS's shelves.
+    Rectangle {
+        Layout.fillWidth: true
+        Layout.bottomMargin: Kirigami.Units.largeSpacing
+        implicitHeight: 1
+        color: Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b, 0.1)
+    }
+
+    RowLayout {
+        Layout.fillWidth: true
+        Kirigami.Heading {
+            Layout.fillWidth: true
+            level: 2
+            font.weight: Font.Bold
+            text: shelf.title
+            elide: Text.ElideRight
+        }
+        QQC2.Label {
+            visible: shelf.seeAll !== null
+            text: i18nc("@action:button show all apps of a shelf", "See All")
+            color: Kirigami.Theme.focusColor
+            MouseArea {
+                anchors.fill: parent
+                anchors.margins: -4
+                cursorShape: Qt.PointingHandCursor
+                onClicked: shelf.seeAll()
+            }
+        }
+    }
+
+    GridLayout {
+        id: grid
+        Layout.fillWidth: true
+        columns: shelf.columns
+        columnSpacing: Kirigami.Units.gridUnit * 1.5
+        rowSpacing: 0
+        // Down each column, then across, as macOS fills its shelves.
+        flow: GridLayout.TopToBottom
+        rows: Math.ceil(shelf.shown / shelf.columns)
+
+        Repeater {
+            id: repeater
+            delegate: MacAppRow {
+                required property int index
+                required property var model
+                application: model.application
+                visible: index < shelf.shown
+                Layout.fillWidth: true
+                Layout.preferredWidth: 1
+                separator: (index + 1) % grid.rows !== 0 && index < shelf.shown - 1
+            }
+        }
+    }
+}
diff --git a/discover/qml/MacSidebar.qml b/discover/qml/MacSidebar.qml
new file mode 100644
index 000000000..ce837352b
--- /dev/null
+++ b/discover/qml/MacSidebar.qml
@@ -0,0 +1,249 @@
+// SPDX-FileCopyrightText: 2026 Brhett
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+import org.kde.coreaddons as KCoreAddons
+import org.kde.discover as Discover
+import org.kde.kirigami as Kirigami
+import org.kde.kirigamiaddons.components as KirigamiComponents
+
+// App Store: macOS's App Store sidebar. The stoplights and the search field
+// at the top, then Discover, the four themed shelves (Create, Work, Play,
+// Develop: KDE's Graphics, Office, Games and Development categories),
+// Categories and Updates in the accent colour, and the account at the
+// bottom (your installed apps), with Settings beside it. Pinned open: the
+// window leaves room for it, and paints its glass (StoreChrome).
+Kirigami.OverlayDrawer {
+    id: drawer
+
+    required property var chrome
+
+    // DiscoverDrawer's interface, used across the app.
+    readonly property var currentSubMenu: null
+    property string currentSearchText
+    // The item last picked (its key): sections, "installed" or "sources".
+    property string selectedKey: "discover"
+
+    function resetMenu() {
+    }
+
+    function suggestSearchText(text) {
+        searchField.text = text;
+        forceSearchFieldFocus();
+    }
+
+    function forceSearchFieldFocus() {
+        searchField.forceActiveFocus();
+    }
+
+    readonly property var sections: [
+        { key: "discover", name: i18nc("@title the App Store's front page", "Discover"), glyph: "starred-symbolic",
+          run: () => { window.currentTopLevel = ""; window.currentTopLevel = window.topBrowsingComp; } },
+        { key: "create", name: i18nc("@title apps for making things", "Create"), glyph: "draw-brush-symbolic", category: "Graphics" },
+        { key: "work", name: i18nc("@title apps for working", "Work"), glyph: "folder-documents-symbolic", category: "Office" },
+        { key: "play", name: i18nc("@title games", "Play"), glyph: "input-gaming-symbolic", category: "Games" },
+        { key: "develop", name: i18nc("@title apps for developers", "Develop"), glyph: "code-context-symbolic", category: "Development" },
+        { key: "categories", name: i18nc("@title", "Categories"), glyph: "view-grid-symbolic",
+          run: () => { window.currentTopLevel = ""; window.currentTopLevel = window.topCategoriesComp; } },
+        { key: "updates", name: i18nc("@title", "Updates"), glyph: "update-none-symbolic", badge: true,
+          run: () => { window.currentTopLevel = window.topUpdateComp; } },
+    ]
+
+    function open(section) {
+        selectedKey = section.key;
+        if (section.category) {
+            Navigation.openCategory(Discover.CategoryModel.findCategoryByName(section.category));
+        } else {
+            section.run();
+        }
+    }
+
+    // Follow pages opened from elsewhere (Updates from a notification…).
+    Connections {
+        target: window
+        function onCurrentTopLevelChanged() {
+            const keys = {
+                [window.topBrowsingComp]: "discover",
+                [window.topCategoriesComp]: "categories",
+                [window.topUpdateComp]: "updates",
+                [window.topInstalledComp]: "installed",
+                [window.topSourcesComp]: "sources",
+            };
+            if (keys[window.currentTopLevel]) {
+                drawer.selectedKey = keys[window.currentTopLevel];
+            }
+        }
+    }
+
+    edge: Qt.application.layoutDirection === Qt.RightToLeft ? Qt.RightEdge : Qt.LeftEdge
+    modal: false
+    drawerOpen: true
+    handleVisible: false
+    width: Kirigami.Units.gridUnit * 13
+    padding: 0
+    topPadding: 0
+    bottomPadding: 0
+    leftPadding: 0
+    rightPadding: 0
+    // The window paints the glass (StoreChrome blurs behind it).
+    background: Item {}
+
+    contentItem: ColumnLayout {
+        spacing: 0
+
+        // The stoplights; empty space up here moves the window.
+        Item {
+            Layout.fillWidth: true
+            implicitHeight: Kirigami.Units.gridUnit * 2.6
+
+            MouseArea {
+                anchors.fill: parent
+                onPressed: drawer.chrome.startMove()
+                onDoubleClicked: drawer.chrome.toggleMaximized()
+            }
+            MacStoplights {
+                chrome: drawer.chrome
+                x: Kirigami.Units.largeSpacing + 2
+                y: Kirigami.Units.largeSpacing + 2.5
+            }
+        }
+
+        SearchField {
+            id: searchField
+            Layout.fillWidth: true
+            Layout.leftMargin: Kirigami.Units.largeSpacing
+            Layout.rightMargin: Kirigami.Units.largeSpacing
+            Layout.bottomMargin: Kirigami.Units.largeSpacing
+
+            focus: !Kirigami.InputMethod.willShowOnActive
+            page: window.leftPage
+
+            onCurrentSearchTextChanged: {
+                if (currentSearchText.length > 0) {
+                    drawer.selectedKey = "";
+                }
+                const curr = window.leftPage;
+                if (window.pageStack.depth > 1) {
+                    window.pageStack.pop();
+                }
+                if (currentSearchText === "" && (!curr || !curr.hasOwnProperty("search") || !curr.category)) {
+                    if (drawer.selectedKey === "") {
+                        drawer.open(drawer.sections[0]);
+                    }
+                } else if (!curr || !curr.hasOwnProperty("search")) {
+                    Navigation.clearStack();
+                    Navigation.openApplicationList({ search: currentSearchText });
+                } else {
+                    curr.search = currentSearchText;
+                    curr.forceActiveFocus();
+                }
+                drawer.currentSearchText = currentSearchText;
+            }
+            Keys.onDownPressed: list.forceActiveFocus(Qt.TabFocusReason)
+        }
+
+        ListView {
+            id: list
+            Layout.fillWidth: true
+            Layout.fillHeight: true
+            clip: true
+            model: drawer.sections
+            keyNavigationEnabled: true
+            boundsBehavior: Flickable.StopAtBounds
+
+            delegate: MacSidebarRow {
+                id: row
+                required property var modelData
+                width: ListView.view.width
+                selected: drawer.selectedKey === modelData.key
+                text: modelData.name
+                glyph: modelData.glyph
+                badge: modelData.badge && Discover.ResourcesModel.updatesCount > 0 ? Discover.ResourcesModel.updatesCount : 0
+                busy: modelData.badge === true && Discover.ResourcesModel.fetchingUpdatesProgress < 100
+                onClicked: drawer.open(modelData)
+            }
+        }
+
+        // Installs and updates in progress.
+        QQC2.Control {
+            Layout.fillWidth: true
+            visible: Discover.TransactionModel.count > 0
+            padding: Kirigami.Units.largeSpacing
+            contentItem: ProgressView {}
+        }
+
+        // The account: your installed apps; Settings beside it.
+        RowLayout {
+            Layout.fillWidth: true
+            Layout.margins: Kirigami.Units.smallSpacing * 2
+            spacing: 0
+
+            KCoreAddons.KUser {
+                id: user
+            }
+
+            MacSidebarRow {
+                id: account
+                Layout.fillWidth: true
+                implicitHeight: Kirigami.Units.gridUnit * 2.6
+                inset: 0
+                selected: drawer.selectedKey === "installed"
+                onClicked: {
+                    drawer.selectedKey = "installed";
+                    window.currentTopLevel = window.topInstalledComp;
+                }
+
+                RowLayout {
+                    anchors.fill: parent
+                    anchors.leftMargin: Kirigami.Units.smallSpacing * 2
+                    anchors.rightMargin: Kirigami.Units.smallSpacing * 2
+                    spacing: Kirigami.Units.largeSpacing
+
+                    KirigamiComponents.Avatar {
+                        Layout.preferredWidth: Kirigami.Units.gridUnit * 1.6
+                        Layout.preferredHeight: Layout.preferredWidth
+                        source: user.faceIconUrl
+                        name: user.fullName || user.loginName
+                    }
+                    ColumnLayout {
+                        Layout.fillWidth: true
+                        spacing: 0
+                        QQC2.Label {
+                            Layout.fillWidth: true
+                            text: user.fullName || user.loginName
+                            font.weight: Font.DemiBold
+                            elide: Text.ElideRight
+                            color: account.selected ? "white" : Kirigami.Theme.textColor
+                        }
+                        QQC2.Label {
+                            Layout.fillWidth: true
+                            text: i18nc("@label under the user's name: their installed apps", "Your Apps")
+                            font: Kirigami.Theme.smallFont
+                            elide: Text.ElideRight
+                            opacity: 0.7
+                            color: account.selected ? "white" : Kirigami.Theme.textColor
+                        }
+                    }
+                }
+            }
+
+            QQC2.ToolButton {
+                icon.name: "configure-symbolic"
+                display: QQC2.AbstractButton.IconOnly
+                text: i18nc("@action:button", "Settings")
+                checked: drawer.selectedKey === "sources"
+                onClicked: {
+                    drawer.selectedKey = "sources";
+                    window.currentTopLevel = window.topSourcesComp;
+                }
+                QQC2.ToolTip.text: text
+                QQC2.ToolTip.visible: hovered
+                QQC2.ToolTip.delay: Kirigami.Units.toolTipDelay
+            }
+        }
+    }
+}
diff --git a/discover/qml/MacSidebarRow.qml b/discover/qml/MacSidebarRow.qml
new file mode 100644
index 000000000..78bc51832
--- /dev/null
+++ b/discover/qml/MacSidebarRow.qml
@@ -0,0 +1,81 @@
+// SPDX-FileCopyrightText: 2026 Brhett
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+import org.kde.kirigami as Kirigami
+
+// App Store: a sidebar row, as macOS's: a glyph in the accent colour and a
+// name, on a rounded selection in the accent colour (glyph and name turn
+// white). A badge counts (updates); `busy` spins instead while fetching.
+// Children replace the glyph and name (the account row).
+MouseArea {
+    id: row
+
+    property bool selected: false
+    property string text
+    property string glyph
+    property int badge: 0
+    property bool busy: false
+    // Space between the window edge and the selection.
+    property real inset: Kirigami.Units.smallSpacing * 2
+
+    implicitHeight: Kirigami.Units.gridUnit * 1.75
+    hoverEnabled: true
+    Accessible.role: Accessible.ListItem
+    Accessible.name: text
+
+    Rectangle {
+        anchors.fill: parent
+        anchors.leftMargin: row.inset
+        anchors.rightMargin: row.inset
+        radius: 6
+        color: row.selected ? Kirigami.Theme.focusColor
+             : row.containsMouse ? Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b, 0.07)
+             : "transparent"
+    }
+
+    RowLayout {
+        anchors.fill: parent
+        anchors.leftMargin: row.inset + Kirigami.Units.smallSpacing * 2
+        anchors.rightMargin: row.inset + Kirigami.Units.smallSpacing * 2
+        spacing: Kirigami.Units.mediumSpacing
+        visible: row.text.length > 0
+
+        Kirigami.Icon {
+            Layout.preferredWidth: Kirigami.Units.iconSizes.small
+            Layout.preferredHeight: Layout.preferredWidth
+            source: row.glyph
+            isMask: true
+            color: row.selected ? "white" : Kirigami.Theme.focusColor
+        }
+        QQC2.Label {
+            Layout.fillWidth: true
+            text: row.text
+            elide: Text.ElideRight
+            color: row.selected ? "white" : Kirigami.Theme.textColor
+        }
+        QQC2.BusyIndicator {
+            Layout.preferredWidth: Kirigami.Units.iconSizes.small
+            Layout.preferredHeight: Layout.preferredWidth
+            visible: row.busy
+            running: visible
+        }
+        // macOS's count: a small gray capsule.
+        Rectangle {
+            visible: row.badge > 0 && !row.busy
+            implicitWidth: Math.max(height, count.implicitWidth + 10)
+            implicitHeight: count.implicitHeight + 2
+            radius: height / 2
+            color: row.selected ? Qt.rgba(1, 1, 1, 0.25) : Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b, 0.15)
+            QQC2.Label {
+                id: count
+                anchors.centerIn: parent
+                text: row.badge
+                font: Kirigami.Theme.smallFont
+                color: row.selected ? "white" : Kirigami.Theme.textColor
+            }
+        }
+    }
+}
diff --git a/discover/qml/MacStoplights.qml b/discover/qml/MacStoplights.qml
new file mode 100644
index 000000000..f5a048d29
--- /dev/null
+++ b/discover/qml/MacStoplights.qml
@@ -0,0 +1,77 @@
+// SPDX-FileCopyrightText: 2026 Brhett
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Shapes
+
+// The window's close, minimize and zoom buttons, as on macOS: glyphs on
+// hover, gray while the window is inactive. Sized like the window
+// decorations' (MacSequoia draws ~22 px circles 35 px apart at 1.5×), so
+// all windows' stoplights match (Settings, Finder).
+Row {
+    id: lights
+
+    required property var chrome
+
+    spacing: 8.8
+    readonly property bool lit: chrome.active || lightsHover.hovered
+
+    HoverHandler {
+        id: lightsHover
+    }
+
+    Repeater {
+        model: [
+            { color: "#ff5f57", kind: "close", action: () => lights.chrome.close() },
+            { color: "#febc2e", kind: "minimize", action: () => lights.chrome.minimize() },
+            { color: "#28c840", kind: "zoom", action: () => lights.chrome.toggleMaximized() }
+        ]
+        delegate: Rectangle {
+            id: light
+            required property var modelData
+            width: 14.5
+            height: width
+            radius: width / 2
+            color: !lights.lit ? "#505054" : lightMouse.pressed ? Qt.darker(modelData.color, 1.25) : modelData.color
+            border.width: 0.5
+            border.color: Qt.rgba(0, 0, 0, 0.2)
+
+            // The glyph, drawn (a font's ×, − and + never sit quite in the
+            // middle): ×, −, and the zoom's two arrows, as Finder.
+            Shape {
+                id: glyph
+                anchors.fill: parent
+                visible: lightsHover.hovered
+                preferredRendererType: Shape.CurveRenderer
+                readonly property real c: light.width / 2
+                readonly property real k: 2.6 * light.width / 12
+
+                ShapePath {
+                    strokeColor: light.modelData.kind === "zoom" ? "transparent" : Qt.rgba(0, 0, 0, 0.6)
+                    strokeWidth: 1.4
+                    fillColor: light.modelData.kind === "zoom" ? Qt.rgba(0, 0, 0, 0.6) : "transparent"
+                    capStyle: ShapePath.RoundCap
+                    PathSvg {
+                        readonly property real c: glyph.c
+                        readonly property real k: glyph.k
+                        readonly property real t: 3.2 * light.width / 12
+                        readonly property real u: 1.2 * light.width / 12
+                        path: light.modelData.kind === "close"
+                            ? `M ${c - k} ${c - k} L ${c + k} ${c + k} M ${c - k} ${c + k} L ${c + k} ${c - k}`
+                            : light.modelData.kind === "minimize"
+                            ? `M ${c - k - 0.4} ${c} L ${c + k + 0.4} ${c}`
+                            : `M ${c - t} ${c - t} L ${c + u} ${c - t} L ${c - t} ${c + u} Z M ${c + t} ${c + t} L ${c - u} ${c + t} L ${c + t} ${c - u} Z`
+                    }
+                }
+            }
+            MouseArea {
+                id: lightMouse
+                anchors.fill: parent
+                anchors.margins: -3
+                onClicked: light.modelData.action()
+            }
+        }
+    }
+}
diff --git a/discover/qml/MacToolbar.qml b/discover/qml/MacToolbar.qml
new file mode 100644
index 000000000..7f0b4fdcc
--- /dev/null
+++ b/discover/qml/MacToolbar.qml
@@ -0,0 +1,62 @@
+// SPDX-FileCopyrightText: 2026 Brhett
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+import QtQuick
+import QtQuick.Controls as QQC2
+import QtQuick.Layouts
+import org.kde.kirigami as Kirigami
+
+// App Store: the strip above the page, where macOS's App Store keeps its
+// toolbar: ‹ back when a page was opened from another, the page's title
+// (unless the page shows its own large one: macOwnTitle, isHome), and the
+// page's actions at the right. Empty space moves the window, as a title bar.
+Item {
+    id: bar
+
+    required property var chrome
+    required property var pageStack
+
+    readonly property Item page: pageStack.currentItem
+
+    implicitHeight: Kirigami.Units.gridUnit * 2.6
+
+    MouseArea {
+        anchors.fill: parent
+        onPressed: bar.chrome.startMove()
+        onDoubleClicked: bar.chrome.toggleMaximized()
+    }
+
+    RowLayout {
+        anchors.fill: parent
+        anchors.leftMargin: Kirigami.Units.largeSpacing
+        anchors.rightMargin: Kirigami.Units.largeSpacing
+        spacing: Kirigami.Units.smallSpacing
+
+        QQC2.ToolButton {
+            visible: bar.pageStack.depth > 1
+            icon.name: Qt.application.layoutDirection === Qt.RightToLeft ? "go-next-symbolic" : "go-previous-symbolic"
+            display: QQC2.AbstractButton.IconOnly
+            text: i18nc("@action:button", "Back")
+            onClicked: bar.pageStack.goBack()
+            QQC2.ToolTip.text: text
+            QQC2.ToolTip.visible: hovered
+            QQC2.ToolTip.delay: Kirigami.Units.toolTipDelay
+        }
+
+        QQC2.Label {
+            Layout.fillWidth: true
+            Layout.leftMargin: Kirigami.Units.smallSpacing
+            text: bar.page && !bar.page.hasOwnProperty("isHome") && !bar.page.hasOwnProperty("macOwnTitle") ? bar.page.title : ""
+            font.weight: Font.Bold
+            font.pointSize: Kirigami.Theme.defaultFont.pointSize * 1.15
+            elide: Text.ElideRight
+        }
+
+        Kirigami.ActionToolBar {
+            Layout.fillWidth: true
+            alignment: Qt.AlignRight
+            flat: true
+            actions: bar.page?.actions ?? []
+        }
+    }
+}
