+void FinderAirDrop::share(const QList<QUrl> &files, QWidget *parent)
+{
+    auto *sheet = new FinderAirDropSheet(files, parent);
+    sheet->setAttribute(Qt::WA_DeleteOnClose);
+    sheet->open();
+}
