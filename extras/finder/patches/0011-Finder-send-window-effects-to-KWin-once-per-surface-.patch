From 0e7dd5f654ccd81650c12d2513cba1fdbee078f9 Mon Sep 17 00:00:00 2001
From: Brhett <36874370+jingledingle521@users.noreply.github.com>
Date: Sun, 18 Oct 2026 12:16:17 -0500
Subject: [PATCH 11/32] Finder: send window effects to KWin once per surface,
 not on every expose

Re-applying blur and re-attaching the shadow on each Expose flooded the
compositor (dozens of shadow re-creations per second while the window
updated).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KdkdNUmoM62iDwjRop6X5f
---
 src/finder/finderchrome.cpp | 38 +++++++++++++++++++++++++++----------
 src/finder/finderchrome.h   |  4 ++++
 2 files changed, 32 insertions(+), 10 deletions(-)

diff --git a/src/finder/finderchrome.cpp b/src/finder/finderchrome.cpp
index 846ddf346..9b6cccbe6 100644
--- a/src/finder/finderchrome.cpp
+++ b/src/finder/finderchrome.cpp
@@ -782,14 +782,23 @@ bool FinderChrome::eventFilter(QObject *watched, QEvent *event)
     if (watched == m_window->windowHandle()) {
         // Resizing from the window edges (there is no window frame to grab).
         switch (event->type()) {
-        case QEvent::Expose:
         case QEvent::PlatformSurface:
-            // The Wayland surface exists only once the window is exposed;
-            // effects requested earlier may not have stuck.
-            QTimer::singleShot(0, this, [this]() {
-                updateWindowEffects();
-                updateShadow();
-            });
+            // A new native surface has none of our effects yet.
+            m_surfaceReady = false;
+            m_appliedBlur = QRegion();
+            m_blurApplied = false;
+            break;
+        case QEvent::Expose:
+            // The Wayland surface exists only once the window is exposed, so
+            // apply the effects then, but only once per surface: Expose fires
+            // often, and re-sending them each time floods the compositor.
+            if (!m_surfaceReady && m_window->windowHandle()->isExposed()) {
+                m_surfaceReady = true;
+                QTimer::singleShot(0, this, [this]() {
+                    updateWindowEffects();
+                    updateShadow();
+                });
+            }
             break;
         case QEvent::MouseMove: {
             auto *e = static_cast<QMouseEvent *>(event);
@@ -883,7 +892,12 @@ void FinderChrome::updateWindowEffects()
         const QPolygon shape = roundedPath(QRectF(m_window->rect()), radius()).toFillPolygon().toPolygon();
         blur = QRegion(strip).intersected(QRegion(shape));
     }
+    if (m_blurApplied && blur == m_appliedBlur) {
+        return; // unchanged; don't bother KWin
+    }
     KWindowEffects::enableBlurBehind(handle, !blur.isEmpty(), blur);
+    m_appliedBlur = blur;
+    m_blurApplied = true;
 }
 
 void FinderChrome::updateShadow()
@@ -939,8 +953,12 @@ void FinderChrome::updateShadow()
         m_shadow->setLeftTile(tile(QRect(0, c, pad, 1)));
         m_shadow->setPadding(QMargins(pad, pad, pad, pad));
     }
-    m_shadow->setWindow(handle);
-    if (!m_shadow->isCreated()) {
-        m_shadow->create();
+    if (m_shadow->isCreated() && m_shadow->window() == handle) {
+        return; // already attached
     }
+    if (m_shadow->isCreated()) {
+        m_shadow->destroy();
+    }
+    m_shadow->setWindow(handle);
+    m_shadow->create();
 }
diff --git a/src/finder/finderchrome.h b/src/finder/finderchrome.h
index ae408c4a4..b76c71647 100644
--- a/src/finder/finderchrome.h
+++ b/src/finder/finderchrome.h
@@ -10,6 +10,7 @@
 #include <QIcon>
 #include <QObject>
 #include <QPointer>
+#include <QRegion>
 
 class KWindowShadow;
 class QMainWindow;
@@ -71,6 +72,9 @@ private:
     QPointer<QWidget> m_navigator; // the hidden breadcrumb
     QPointer<QAction> m_navigatorAction;
     KWindowShadow *m_shadow = nullptr;
+    QRegion m_appliedBlur; // last blur region sent to KWin
+    bool m_blurApplied = false;
+    bool m_surfaceReady = false; // effects sent for the current native surface
     Qt::Edges m_cursorEdges;
 };
 
