 src/kitemviews/kitemlistview.cpp                |  3 ++-
 src/kitemviews/kstandarditemlistgroupheader.cpp | 15 +++++++++++++--
 src/kitemviews/kstandarditemlistwidget.cpp      |  4 +++-
