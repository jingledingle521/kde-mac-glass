 src/finder/finderchrome.h       |   2 +
 src/finder/findercolumnview.cpp | 166 ++++++++++++++++++++++++++++++++
 src/finder/findercolumnview.h   |  14 +++
 4 files changed, 217 insertions(+)

diff --git a/src/finder/finderchrome.cpp b/src/finder/finderchrome.cpp
