From 249579319ad3b11e75c80622d0bc4802bb72b959 Mon Sep 17 00:00:00 2001
From: Brhett <36874370+jingledingle521@users.noreply.github.com>
Date: Sun, 18 Oct 2026 14:12:31 -0500
Subject: [PATCH 22/48] Finder column view: fix crash on opening column view

setModel() calls currentChanged() from the constructor, before the footer
timer existed. Create the timer first and guard its use.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KdkdNUmoM62iDwjRop6X5f
---
 src/finder/findercolumnview.cpp | 16 ++++++++++------
 src/finder/findercolumnview.h   |  2 +-
 2 files changed, 11 insertions(+), 7 deletions(-)

diff --git a/src/finder/findercolumnview.cpp b/src/finder/findercolumnview.cpp
index 567f83b6c..40ae8f589 100644
--- a/src/finder/findercolumnview.cpp
+++ b/src/finder/findercolumnview.cpp
@@ -113,6 +113,13 @@ FinderColumnView::FinderColumnView(QWidget *parent)
     , m_model(new KDirModel(this))
     , m_proxy(new KDirSortFilterProxyModel(this))
 {
+    // Created first: setModel() below already calls currentChanged(), which uses it.
+    // The footer counts items, which arrive as folders list: update shortly after.
+    m_statusTimer = new QTimer(this);
+    m_statusTimer->setSingleShot(true);
+    m_statusTimer->setInterval(120);
+    connect(m_statusTimer, &QTimer::timeout, this, &FinderColumnView::currentFolderChanged);
+
     m_proxy->setSourceModel(m_model);
     m_proxy->setSortFoldersFirst(false); // Finder sorts folders and files together
     m_proxy->setSortCaseSensitivity(Qt::CaseInsensitive);
@@ -164,11 +171,6 @@ FinderColumnView::FinderColumnView(QWidget *parent)
 
     connect(this, &QAbstractItemView::activated, this, &FinderColumnView::openIndex);
 
-    // The footer counts items, which arrive as folders list: update shortly after.
-    m_statusTimer = new QTimer(this);
-    m_statusTimer->setSingleShot(true);
-    m_statusTimer->setInterval(120);
-    connect(m_statusTimer, &QTimer::timeout, this, &FinderColumnView::currentFolderChanged);
     connect(m_proxy, &QAbstractItemModel::rowsInserted, m_statusTimer, qOverload<>(&QTimer::start));
     connect(m_proxy, &QAbstractItemModel::rowsRemoved, m_statusTimer, qOverload<>(&QTimer::start));
 }
@@ -185,7 +187,9 @@ void FinderColumnView::setShowHiddenFiles(bool show)
 void FinderColumnView::currentChanged(const QModelIndex &current, const QModelIndex &previous)
 {
     QColumnView::currentChanged(current, previous);
-    m_statusTimer->start();
+    if (m_statusTimer) {
+        m_statusTimer->start();
+    }
 }
 
 QUrl FinderColumnView::currentFolder() const
diff --git a/src/finder/findercolumnview.h b/src/finder/findercolumnview.h
index a257fbce5..8f900ba08 100644
--- a/src/finder/findercolumnview.h
+++ b/src/finder/findercolumnview.h
@@ -63,7 +63,7 @@ private:
     KDirModel *m_model;
     KDirSortFilterProxyModel *m_proxy;
     QUrl m_root;
-    QTimer *m_statusTimer; // coalesces footer updates while folders list
+    QTimer *m_statusTimer = nullptr; // coalesces footer updates while folders list
 
     QWidget *m_preview;
     QLabel *m_previewIcon;
