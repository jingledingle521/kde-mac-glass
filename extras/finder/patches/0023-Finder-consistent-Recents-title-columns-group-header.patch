         { "type",                TypeRole,                kli18nc("@label", "Kind"),                 KLazyLocalizedString(),        KLazyLocalizedString(),                    false,           false },
         { "rating",              RatingRole,              kli18nc("@label", "Rating"),               KLazyLocalizedString(),        KLazyLocalizedString(),                    true,            false },
